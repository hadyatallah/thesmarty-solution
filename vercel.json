{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/projects.html",
      "destination": "/opportunities.html",
      "permanent": true
    },
    {
      "source": "/cyprus-investment-opportunities.html",
      "destination": "/opportunities.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/tss-hubspot-enquiry-sync",
      "destination": "/api/crm?tssHubspotSync=1"
    },
    {
      "source": "/api/outlook/ingestion/enable",
      "destination": "/api/outlook/status?captureAction=enable"
    },
    {
      "source": "/api/outlook/ingestion/status",
      "destination": "/api/outlook/status?captureAction=status"
    },
    {
      "source": "/api/outlook/ingestion/disable",
      "destination": "/api/outlook/status?captureAction=disable"
    },
    {
      "source": "/api/outlook/sync",
      "destination": "/api/outlook/status?captureAction=sync"
    }
  ],
  "crons": [
    {
      "path": "/api/tss-hubspot-enquiry-sync",
      "schedule": "0 7 * * *"
    }
  ]
}
